{
  "info": {
    "_postman_id": "a9e61d78-9226-4840-a887-24691448a9e7",
    "name": "Prismatic GraphQL API",
    "description": "Prismatic provides a GraphQL-based API for building, deploying, and supporting integrations programmatically. The API allows you to manage customers, integrations, instances, components, and other resources. GraphQL operations include queries (pulling data) and mutations (creating, modifying, or deleting data). The API endpoint accepts GraphQL queries via HTTP POST requests. Authentication is handled via JWT bearer tokens obtained through the Prismatic web app or CLI tool.\n\nContact Support:\n Name: Prismatic",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:14:15.000Z",
    "updatedAt": "2026-06-05T15:14:15.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-a9e61d78-9226-4840-a887-24691448a9e7"
  },
