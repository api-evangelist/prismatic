        {
          "id": "af51d906-a72c-4fed-a59c-0c89523e7132",
          "name": "Prismatic Get Short-Lived Auth Token",
          "request": {
            "name": "Prismatic Get Short-Lived Auth Token",
            "description": {
              "content": "Retrieve a short-lived authentication token while logged in to the Prismatic web application. This endpoint is accessed via browser and returns a JWT that can be used for API queries.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "get_auth_token",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "session"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
