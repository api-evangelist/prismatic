  "info": {
    "_postman_id": "39a22674-20d2-4031-989b-cc4e81109de5",
    "name": "Prismatic GraphQL Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Prismatic provides a GraphQL-based API for building, deploying, and supporting integrations programmatically. The API allows you to manage customers, integrations, instances, components, and other resources. GraphQL operations include queries (pulling data) and mutations (creating, modifying, or deleting data). The API endpoint accepts GraphQL queries via HTTP POST requests. Authentication is handled via JWT bearer tokens obtained through the Prismatic web app or CLI tool.\n\nContact Support:\n Name: Prismatic",
      "type": "text/plain"
    }
  }
